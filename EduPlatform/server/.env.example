# Configuration de la base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/eduplatform

# Configuration du serveur
PORT=3000
# Configuration de l'environnement
NODE_ENV=development

# Configuration de la sécurité
# Configuration JWT
# IMPORTANT: Générez une clé secrète forte et unique
# Vous pouvez utiliser : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_secret_jwt_super_securise_changez_moi

#Exemple de clé générée :
# JWT_SECRET=9f3b2c1a7d8e4f6b3c2a9d1e6f7a8c4b5d6e2f3a9b1c4d6e7f8a2b3c1d4e5f6 
